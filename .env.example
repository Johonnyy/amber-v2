# Amber configuration — copy to `.env` and fill in.
# All values are read by app/config.py (pydantic-settings). Env vars override .env.

# --- Secrets (required) ---
# STT (Whisper) + TTS.
AMBER_OPENAI_API_KEY=sk-...
# The LLM brain, via OpenRouter (agent-runtime). Replaces the old Anthropic key:
# the brain now reaches every provider through one endpoint and a named tier.
# Required unless AMBER_FEATURE_LLM=false.
AMBER_OPENROUTER_API_KEY=sk-or-...

# --- Server ---
AMBER_HOST=0.0.0.0
AMBER_PORT=8000
AMBER_LOG_LEVEL=INFO
# IANA timezone the brain's clock is read in (drives the date/time line injected
# into every prompt). Unknown/unavailable zones fall back to UTC.
AMBER_TIMEZONE=UTC

# --- Models (swappable; see CLAUDE.md "Config") ---
# Speech-to-text (Whisper).
AMBER_STT_MODEL=whisper-1
# Text-to-speech.
AMBER_TTS_MODEL=tts-1
AMBER_TTS_VOICE=alloy
# Audio container streamed back to the client, per sentence.
# One of: mp3, opus, aac, flac, wav, pcm
AMBER_TTS_FORMAT=mp3
# The brain, as a named TIER resolved by agent-runtime's model_router
# (cheap / balanced / strong), not a model id. One edit in the router moves every
# app in the ecosystem. "balanced" is Claude Haiku today — what Amber used before.
# A literal model id containing "/" still passes through as an escape hatch.
AMBER_LLM_TIER=balanced
# Cap on a single spoken reply (tokens). Voice answers are short; keep it modest.
AMBER_LLM_MAX_TOKENS=1024
# The memory writer's fact-extraction tier. Off the latency path, so it could be
# beefier; defaults to the brain's for cost and simplicity.
AMBER_MEMORY_TIER=balanced
# Token cap for one fact-extraction call (short JSON list). Keep low.
AMBER_MEMORY_EXTRACT_MAX_TOKENS=512

# --- Memory (Phase 3) ---
# SQLite file holding persistent cross-session knowledge (facts/conversations/tasks).
AMBER_MEMORY_DB_PATH=amber.db
# Hard cap on facts injected into the prompt per turn (memory costs tokens; keep small).
AMBER_MEMORY_MAX_FACTS=12
# Hard cap on new facts kept from a single exchange.
AMBER_MEMORY_MAX_NEW_FACTS=5
# On a cold session start (empty live history), how many recent durable messages to
# replay into the prompt as a "where you left off" recap. 0 disables it.
AMBER_RECENT_RECAP_MESSAGES=8
# How many recent durable messages the recall_recent tool returns when the user
# refers back to an earlier conversation. Off the per-turn path (only paid when the
# model calls the tool), so it can be larger than the always-on recap above.
AMBER_RECALL_MESSAGES=12

# --- Memory retrieval & lifecycle ---
# Character budget for the memory block. The fact cap above counts rows; this counts
# what they actually cost, since twelve long facts are far dearer than twelve short.
AMBER_MEMORY_MAX_CHARS=1200
# Candidate facts pulled from the index before scoring. Well above the fact cap so
# ranking has a choice, well below the table size so it's never a full scan.
AMBER_MEMORY_CANDIDATES=40
# Most-used durable facts always included regardless of relevance. Identity-level
# knowledge ("lives in Denver") rarely shares words with the question, so pure
# relevance ranking drops exactly the facts that matter most.
AMBER_MEMORY_ALWAYS_DURABLE=5
# Cap on open tasks surfaced in the memory block.
AMBER_MEMORY_MAX_TASKS=8
# Fact lifecycle, applied by the maintenance pass. A short-tier fact used fewer than
# twice and untouched this long is forgotten; a session-tier one goes much sooner.
# Durable facts never decay — they leave only by being superseded or forgotten.
AMBER_FACT_SHORT_TTL_DAYS=30
AMBER_FACT_SESSION_TTL_HOURS=12
# Uses at which a short-tier fact is promoted to durable. Being repeatedly useful is
# the only evidence of durability that doesn't need a model.
AMBER_FACT_PROMOTE_USES=3
# Retention for the raw exchange log (the substrate for recall, not an archive).
AMBER_CONVERSATION_KEEP_DAYS=180

# --- Maintenance (the self-improvement loop) ---
# Runs periodically: decay, promotion, consolidation, pruning, self-review. The
# startup delay is not cosmetic — it keeps app startup (including tests) from
# immediately firing a pass.
AMBER_MAINTENANCE_STARTUP_DELAY_S=300
AMBER_MAINTENANCE_INTERVAL_S=21600
# The tier that consolidates facts and writes reflections. Off the latency path, so
# it can be stronger than the brain.
AMBER_MAINTENANCE_TIER=balanced
AMBER_MAINTENANCE_MAX_TOKENS=1024
# Facts handed to one consolidation call — bounds cost and blast radius.
AMBER_MAINTENANCE_MAX_FACTS=60
# Hard cap on mutations applied from one model response: a confused model gets to
# make a mess of at most this many facts.
AMBER_MAINTENANCE_MAX_CHANGES=20
AMBER_MAINTENANCE_MAX_REFLECTIONS=3
# Retention for telemetry rows.
AMBER_SIGNALS_KEEP_DAYS=30

# Run `python -m app.maintenance` to run one pass by hand and print what it did.

# --- Tools (Phase 4) ---
# Max tool-use round trips per turn before Amber must answer with what it has.
AMBER_MAX_TOOL_ITERATIONS=5
# Web search backend:
#   "auto"       — (default) tavily when AMBER_SEARCH_API_KEY is set, duckduckgo
#                  when it isn't. The good backend when available, a working one
#                  otherwise, no configuration required either way.
#   "tavily"     — search API built for LLMs: a synthesized answer plus ranked
#                  sourced snippets. Needs a key (the free tier is generous).
#                  ** THIS IS THE SINGLE BIGGEST QUALITY WIN AVAILABLE. **
#   "duckduckgo" — keyless. Instant Answers alone answers almost nothing, so this
#                  falls back to scraping the HTML results page — best-effort, and
#                  it will break whenever their markup changes.
# There used to be an "anthropic" provider: a NATIVE server-side search that ran
# inside the LLM request and was the default. It went when the brain moved to
# agent-runtime — a server tool only exists inside a provider's own request loop,
# and the OpenAI-compatible endpoint has no equivalent. Tavily is the closest
# replacement, which is why "auto" prefers it.
AMBER_SEARCH_PROVIDER=auto
# Get one at tavily.com. Required for the tavily provider; with it set, "auto"
# picks tavily automatically.
AMBER_SEARCH_API_KEY=
# Cap on result snippets folded into one search result (keep small; costs tokens).
AMBER_SEARCH_MAX_RESULTS=5
AMBER_SEARCH_TIMEOUT_S=10
# read_url — fetch one page and hand Amber its readable text, usually following a
# search result. Requests to loopback/private/link-local addresses are refused
# before any connection is made (Amber is internet-facing; this is a real SSRF
# surface).
AMBER_READ_URL_TIMEOUT_S=15
# Hard cap on the download, enforced while streaming rather than by trusting the
# Content-Length header.
AMBER_READ_URL_MAX_BYTES=2097152
# Characters of extracted text handed to the model.
AMBER_READ_URL_MAX_CHARS=4000
# Peer MCP servers Amber may call as a client, as "name=https://host" pairs (no
# /mcp suffix — that is appended for you). Heavy or delegated work goes here now
# that the OpenClaw bridge is gone: the inline-vs-delegated distinction survives,
# only the far end changed. Empty means inline tools only.
AMBER_MCP_PEERS=
# Bearer token presented to peers that do not carry their own in the registry.
AMBER_MCP_PEER_TOKEN=
# update_server tool — runs the deploy update script on the box. Empty = the tool
# is hidden from the model (it's a privileged, server-mutating action), which is
# why "update your backend" gets a flat "I can't". Set it to enable voice updates.
# The command runs through a shell, AS THE SERVICE USER. update.sh needs root
# (systemctl, /etc) and restarts the service, so:
#   - prefix with sudo (the service user needs passwordless sudo for it), and
#   - run it DETACHED via systemd-run so the restart can't kill the update, and
#   - the service unit must allow sudo: NoNewPrivileges=true BLOCKS it — set it to
#     `no`, or sudo silently fails. (Check: systemctl show amber -p NoNewPrivileges)
# Point it at deploy/update.sh in YOUR app dir (it auto-detects the dir + user):
#   AMBER_UPDATE_COMMAND=sudo systemd-run --collect --unit=amber-update bash /opt/amber/deploy/update.sh
AMBER_UPDATE_COMMAND=
# How long to wait for the update command before reporting it as "started" (the
# detached job keeps running regardless).
AMBER_UPDATE_TIMEOUT_S=120
# Client-declared tools — capabilities a client can run on its own device (show
# text, play a sound, ...). The client sends them over the socket and Amber offers
# them prefixed with "client_". Cap on how many one client may register.
AMBER_MAX_CLIENT_TOOLS=16
# How long the brain waits for a client to return a tool result before giving up.
AMBER_CLIENT_TOOL_TIMEOUT_S=30

# --- Feature flags ---
# When false, STT is skipped and the canned greeting is returned for any audio.
# Useful to smoke-test the TTS-return half of the pipe without spending STT calls.
AMBER_FEATURE_STT=true
# When false, the LLM brain is bypassed and the Phase-1 canned reply is returned.
# Lets the pipe run end to end without an Anthropic key (tests, demos).
AMBER_FEATURE_LLM=true
# When false, no memory is read into the prompt and no facts are extracted —
# the pipeline behaves exactly as Phase 2 (no DB, no extra LLM calls).
AMBER_FEATURE_MEMORY=true
# When false, the brain never offers tools to the model — it streams a direct
# reply exactly as Phase 2/3 (no tool round trips).
AMBER_FEATURE_TOOLS=true
# When false, Amber's own MCP server is not mounted. She stays a *caller* of other
# agents either way; this only controls whether she is queryable herself.
AMBER_FEATURE_MCP_SERVER=true
# Telemetry: tool outcomes, corrections, barge-ins, per-turn shape. This is what the
# maintenance pass reflects on — with it off, memory hygiene still runs but Amber
# notices nothing about how conversations are going. Never on the latency path.
AMBER_FEATURE_SIGNALS=true
# The periodic self-maintenance pass. Off means memory never curates itself:
# duplicates accumulate, contradictions sit side by side, and stale one-offs crowd
# out what matters.
AMBER_FEATURE_MAINTENANCE=true
# When true, the notes the maintenance pass writes about itself are injected into
# every system prompt. OFF BY DEFAULT and deliberately so: reflections are worth
# reading long before they're worth acting on automatically, and this flag is the
# line between "Amber notices patterns" and "Amber edits her own instructions".
# Read a few first — `amber://memory/reflections` over MCP, or the reflections
# table — then decide. The persona in git is never rewritten either way.
AMBER_FEATURE_SELF_NOTES=false

# --- Amber's own MCP server (agent-mcp-py) ---
# Bearer tokens other agents present to query Amber, comma separated, each
# optionally "name:token" so the usage log records who called rather than a
# fingerprint. NOTE: with no keys the server is simply not mounted — agent-mcp-py
# fails closed, so this is never accidentally an open server.
AMBER_MCP_KEYS=
# Amber's externally reachable base URL, no /mcp suffix. Needed only to register
# with the hosted sync store; she serves normally without it.
AMBER_MCP_PUBLIC_URL=
# The hosted discovery store. Empty disables registration, and an unreachable one
# never blocks startup.
AMBER_MCP_SYNC_STORE_URL=
AMBER_MCP_SYNC_STORE_TOKEN=

# When false, client-declared tools are ignored (never offered, never called back).
# Independent of AMBER_FEATURE_TOOLS (which governs Amber's own server-side tools).
AMBER_FEATURE_CLIENT_TOOLS=true
# Turn-based conversations. When true, the brain may call the expect_reply tool to
# hold a turn open for the user's answer (turn_complete then carries
# awaiting_response, and the client keeps the mic open). False = always one-shot.
AMBER_FEATURE_TURN_BASED=true

# --- Sessions (Phase 5) ---
# How long an idle session's history is retained for reconnect/resume (seconds).
AMBER_SESSION_TTL_S=1800
# Max concurrently retained sessions (memory guardrail; 0 disables the cap).
AMBER_MAX_SESSIONS=1000
# Conversation turns (user+assistant pairs) kept in a session's history. Older
# turns drop off to bound tokens/memory. 0 disables trimming.
AMBER_MAX_HISTORY_TURNS=50

# --- Rate limiting & cost guardrails (Phase 5) ---
# Max utterances per session within the rolling window (0 disables).
AMBER_RATE_LIMIT_TURNS=30
AMBER_RATE_LIMIT_WINDOW_S=60
# Reject an inbound utterance larger than this many bytes before spending STT
# (0 disables the size check).
AMBER_MAX_AUDIO_BYTES=10485760
# Hard cap on total utterances over one session's lifetime (cost guardrail; 0 = off).
AMBER_MAX_TURNS_PER_SESSION=0

# --- Auth (Phase 5; off by default) ---
# When set, clients must present this as ?token=... on the WS URL, or as an
# `Authorization: Bearer <secret>` header. Empty = open socket (no auth).
AMBER_AUTH_SECRET=
