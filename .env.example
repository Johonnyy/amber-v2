# Amber configuration — copy to `.env` and fill in.
# All values are read by app/config.py (pydantic-settings). Env vars override .env.

# --- Secrets (required) ---
# STT (Whisper) + TTS.
AMBER_OPENAI_API_KEY=sk-...
# The LLM brain, via OpenRouter (agent-runtime). Replaces the old Anthropic key:
# the brain now reaches every provider through one endpoint and a named tier.
# Required unless AMBER_FEATURE_LLM=false.
AMBER_OPENROUTER_API_KEY=sk-or-...

# --- Server ---
AMBER_HOST=0.0.0.0
AMBER_PORT=8000
AMBER_LOG_LEVEL=INFO

# --- Models (swappable; see CLAUDE.md "Config") ---
# Speech-to-text (Whisper).
AMBER_STT_MODEL=whisper-1
# Text-to-speech.
AMBER_TTS_MODEL=tts-1
AMBER_TTS_VOICE=alloy
# Audio container streamed back to the client, per sentence.
# One of: mp3, opus, aac, flac, wav, pcm
AMBER_TTS_FORMAT=mp3
# The brain, as a named TIER resolved by agent-runtime's model_router
# (cheap / balanced / strong), not a model id. One edit in the router moves every
# app in the ecosystem. "balanced" is Claude Haiku today — what Amber used before.
# A literal model id containing "/" still passes through as an escape hatch.
AMBER_LLM_TIER=balanced
# Cap on a single spoken reply (tokens). Voice answers are short; keep it modest.
AMBER_LLM_MAX_TOKENS=1024
# The memory writer's fact-extraction tier. Off the latency path, so it could be
# beefier; defaults to the brain's for cost and simplicity.
AMBER_MEMORY_TIER=balanced
# Token cap for one fact-extraction call (short JSON list). Keep low.
AMBER_MEMORY_EXTRACT_MAX_TOKENS=512

# --- Memory (Phase 3) ---
# SQLite file holding persistent cross-session knowledge (facts/conversations/tasks).
AMBER_MEMORY_DB_PATH=amber.db
# Hard cap on facts injected into the prompt per turn (memory costs tokens; keep small).
AMBER_MEMORY_MAX_FACTS=12
# Hard cap on new facts kept from a single exchange.
AMBER_MEMORY_MAX_NEW_FACTS=5

# --- Tools (Phase 4) ---
# Max tool-use round trips per turn before Amber must answer with what it has.
AMBER_MAX_TOOL_ITERATIONS=5
# Web search backend: "duckduckgo" (keyless, default) or "tavily" (needs a key).
AMBER_SEARCH_PROVIDER=duckduckgo
# Required only for the tavily provider.
AMBER_SEARCH_API_KEY=
# Cap on result snippets folded into one search result (keep small; costs tokens).
AMBER_SEARCH_MAX_RESULTS=3
AMBER_SEARCH_TIMEOUT_S=10
# Peer MCP servers Amber may call as a client, as "name=https://host" pairs (no
# /mcp suffix — that is appended for you). Heavy or delegated work goes here now
# that the OpenClaw bridge is gone: the inline-vs-delegated distinction survives,
# only the far end changed. Empty means inline tools only.
AMBER_MCP_PEERS=
# Bearer token presented to peers that do not carry their own in the registry.
AMBER_MCP_PEER_TOKEN=

# --- Feature flags ---
# When false, STT is skipped and the canned greeting is returned for any audio.
# Useful to smoke-test the TTS-return half of the pipe without spending STT calls.
AMBER_FEATURE_STT=true
# When false, the LLM brain is bypassed and the Phase-1 canned reply is returned.
# Lets the pipe run end to end without an Anthropic key (tests, demos).
AMBER_FEATURE_LLM=true
# When false, no memory is read into the prompt and no facts are extracted —
# the pipeline behaves exactly as Phase 2 (no DB, no extra LLM calls).
AMBER_FEATURE_MEMORY=true
# When false, the brain never offers tools to the model — it streams a direct
# reply exactly as Phase 2/3 (no tool round trips).
AMBER_FEATURE_TOOLS=true
# When false, Amber's own MCP server is not mounted. She stays a *caller* of other
# agents either way; this only controls whether she is queryable herself.
AMBER_FEATURE_MCP_SERVER=true

# --- Amber's own MCP server (agent-mcp-py) ---
# Bearer tokens other agents present to query Amber, comma separated, each
# optionally "name:token" so the usage log records who called rather than a
# fingerprint. NOTE: with no keys the server is simply not mounted — agent-mcp-py
# fails closed, so this is never accidentally an open server.
AMBER_MCP_KEYS=
# Amber's externally reachable base URL, no /mcp suffix. Needed only to register
# with the hosted sync store; she serves normally without it.
AMBER_MCP_PUBLIC_URL=
# The hosted discovery store. Empty disables registration, and an unreachable one
# never blocks startup.
AMBER_MCP_SYNC_STORE_URL=
AMBER_MCP_SYNC_STORE_TOKEN=

# --- Sessions (Phase 5) ---
# How long an idle session's history is retained for reconnect/resume (seconds).
AMBER_SESSION_TTL_S=1800
# Max concurrently retained sessions (memory guardrail; 0 disables the cap).
AMBER_MAX_SESSIONS=1000
# Conversation turns (user+assistant pairs) kept in a session's history. Older
# turns drop off to bound tokens/memory. 0 disables trimming.
AMBER_MAX_HISTORY_TURNS=50

# --- Rate limiting & cost guardrails (Phase 5) ---
# Max utterances per session within the rolling window (0 disables).
AMBER_RATE_LIMIT_TURNS=30
AMBER_RATE_LIMIT_WINDOW_S=60
# Reject an inbound utterance larger than this many bytes before spending STT
# (0 disables the size check).
AMBER_MAX_AUDIO_BYTES=10485760
# Hard cap on total utterances over one session's lifetime (cost guardrail; 0 = off).
AMBER_MAX_TURNS_PER_SESSION=0

# --- Auth (Phase 5; off by default) ---
# When set, clients must present this as ?token=... on the WS URL, or as an
# `Authorization: Bearer <secret>` header. Empty = open socket (no auth).
AMBER_AUTH_SECRET=
